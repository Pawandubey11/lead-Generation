# ============================================
# LeadPulse OS — Environment Configuration
# ============================================
# Copy this file to `.env` and fill in your values.
# NEVER commit the .env file to version control.

# --- Session Security ---
LEADPULSE_SECRET_KEY=change-this-to-a-random-64-char-string
LEADPULSE_DEV_MODE=true

# --- Sender Profile Defaults ---
SENDER_NAME=
SENDER_TITLE=
SENDER_COMPANY=

# --- N8N Webhook Integration ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_SEND_ON_COMPLETION=false

# --- Locality Discovery (City-Wide Scraping) ---
MAX_LOCALITIES=30          # Max localities to discover per city (default: 30)
MAX_BIZ_PER_LOCALITY=20    # Max businesses to scrape per locality (default: 20)
MAX_BIZ_PER_CITY=50        # Max businesses per broad city search (default: 50)
